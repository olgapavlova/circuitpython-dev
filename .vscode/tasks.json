{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CircuitPython: залить BLE Logger",
      "type": "shell",
      "command": "./scripts/deploy.sh ble_logger.py"
    },
    {
      "label": "CircuitPython: залить Display Test",
      "type": "shell",
      "command": "./scripts/deploy.sh display_test.py"
    },
    {
      "label": "CircuitPython: залить Brightness Test",
      "type": "shell",
      "command": "./scripts/deploy.sh display_brightness.py"
    },

    {
      "label": "CircuitPython: найти CIRCUITPY",
      "type": "shell",
      "command": "find /mnt -maxdepth 4 -type d -name CIRCUITPY 2>/dev/null"
    },
    {
      "label": "CircuitPython: открыть serial",
      "type": "shell",
      "command": "picocom -b 115200 /dev/ttyACM0",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}