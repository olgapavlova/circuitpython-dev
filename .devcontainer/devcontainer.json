{
  "name": "circuitpython-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "op",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "remoteUser": "op",
  "workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": [
    "--privileged",
    "-v", "/dev:/dev",
    "-v", "/media:/media",
    "-v", "/run/media:/run/media"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/op/.ssh,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
