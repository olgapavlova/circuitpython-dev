{
  "name": "circuitpython-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "op",
  "workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": [
    "--privileged",
    "-v", "/dev:/dev",
    "--name", "circuitpython-dev",
    "--hostname=circuitpython-dev"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/op/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/op/.gitconfig,type=bind,readonly",
    "source=/run/user/1000/gnupg,target=/run/user/1000/gnupg,type=bind",
    "source=${localEnv:HOME}/.gnupg,target=/home/op/.gnupg,type=bind",
    "source=${localEnv:HOME}/.bashrc,target=/home/op/.bashrc,type=bind,readonly",
    "source=${localEnv:HOME}/.terminal_init,target=/home/op/.terminal_init,type=bind,readonly",
    "source=/mnt/CIRCUITPY,target=/mnt/CIRCUITPY,type=bind",
    "source=/mnt/LILYGO/sd,target=/mnt/LILYGO/sd,type=bind"
  ],
  "remoteEnv": {
    "GNUPGHOME": "/home/op/.gnupg"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    }
  }
}